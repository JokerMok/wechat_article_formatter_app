# Server-side AI configuration. Never prefix these variables with NEXT_PUBLIC_.
# Site access code, NOT an upstream API key. Use a random value of 16-256 characters.
# Required in production, including production-built Preview deployments.
# Configure Preview and Production separately in the deployment environment.
# Empty is allowed only for local development/test; do not expose that mode publicly.
# Rate limits are in-memory and per instance, not distributed abuse protection.
AI_ACCESS_CODE=
AI_PROVIDER=openai-compatible
AI_API_KEY=
# Optional server-side key file. When set, the key is read from this file.
AI_API_KEY_FILE=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Volcengine Ark: use the inference endpoint ID, usually ep-xxxxxxxx.
AI_MODEL=
# Optional independent vision endpoint; falls back to AI_MODEL. Must accept image_url inputs.
AI_VISION_MODEL=
# Studio layout defaults to local Ollama (127.0.0.1:11434). Set openai-compatible
# to opt in to the configured cloud endpoint, or off for rules-only layout.
AI_LAYOUT_PROVIDER=ollama
AI_LAYOUT_MODEL=qwen3.5:4b
AI_CHAT_COMPLETIONS_PATH=/chat/completions
# Use max_completion_tokens for endpoints that reject max_tokens.
AI_CHAT_TOKEN_LIMIT_FIELD=max_tokens
# Set to default to omit explicit sampling temperature.
AI_CHAT_TEMPERATURE=
# Overall request budget, including retries; capped at 110000 ms.
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=1
# Optional for providers such as Volcengine Ark; minimal reduces long-article latency.
AI_REASONING_EFFORT=minimal

# Keep empty to run the existing local workspace. "center" enables unified accounts.
ACCOUNT_MODE=
ACCOUNTS_URL=https://accounts.shizibandu.icu
OIDC_ISSUER=https://identity.accounts.shizibandu.icu
OIDC_APPLICATION=zhenyi-wechat-article-formatter
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Exact registered URL: https://<stable-product-host>/auth/callback/wechat-article-formatter
OIDC_REDIRECT_URI=
PRODUCT_ID=wechat-article-formatter
PRODUCT_SERVICE_KEY=
# Product-owned persistent PostgreSQL, never the account center's database.
ACCOUNT_DATABASE_URL=
# Random independent scheduler credential. Enable periodic recovery before enabling quota.
CRON_SECRET=
# Enter the exact registered feature IDs; only article layout supports quota.
ACCOUNT_FEATURE_ARTICLE_LAYOUT=
ACCOUNT_FEATURE_STYLE_CAPTURE=
ACCOUNT_FEATURE_STYLE_VISION=
ACCOUNT_FEATURE_ANALYZE=
ACCOUNT_FEATURE_GENERATE=
# Original separately operated workspace. Required for production HTTPS.
ACCOUNT_LEGACY_URL=
# For isolated development with loopback HTTP only; do not enable on production.
ACCOUNT_ALLOW_LOOPBACK=
