formatter.shizibandu.icu {
	encode zstd gzip
	root * /srv/apps/formatter/current/web
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header X-Frame-Options DENY
	@assets path /_next/static/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@home path /
	header @home Cache-Control "no-cache"
	@ai path /api/ai/analyze /api/ai/generate
	handle @ai {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"ok":false,"error":{"code":"AI_NOT_CONFIGURED","message":"此入口尚未启用服务端 AI。","retryable":false}}` 503
	}
	@public path / /_next/static/*
	handle @public {
		file_server
	}
	handle {
		respond 404
	}
}
