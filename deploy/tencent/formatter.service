[Unit]
Description=Self-media formatter loopback service
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/apps/formatter/current
EnvironmentFile=/srv/apps/formatter/shared/config/runtime.env
Environment=FORMATTER_CHROMIUM_PATH=/run/formatter/chromium
RuntimeDirectory=formatter
RuntimeDirectoryMode=0700
ExecStartPre=/srv/apps/beadgrid-studio/runtime/node-v24.22.0-linux-x64/bin/node /srv/apps/formatter/runtime/prepare-chromium.mjs
ExecStart=/srv/apps/beadgrid-studio/runtime/node-v24.22.0-linux-x64/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
MemoryMax=640M
CPUQuota=50%
TasksMax=96

[Install]
WantedBy=multi-user.target
