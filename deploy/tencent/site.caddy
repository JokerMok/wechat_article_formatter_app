formatter.shizibandu.icu {
	encode zstd gzip
	root * /srv/apps/formatter/current/web
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header X-Frame-Options DENY

	@assets path /_next/static/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@dynamicPages {
		method GET HEAD
		path /
		file /.formatter-dynamic
	}
	handle @dynamicPages {
		header Cache-Control "private, no-store"
		reverse_proxy 127.0.0.1:18877 {
			header_up -RSC
			header_up -Next-Action
			header_up -Next-Resume
			header_up -Next-Router-State-Tree
			header_up -Next-Router-Prefetch
			header_up -Next-Router-Segment-Prefetch
			header_up -X-Middleware-Subrequest
			header_up -X-Middleware-Set-Cookie
		}
	}

	@dynamicAI {
		method GET POST
		path /api/ai/session /api/ai/analyze /api/ai/generate /api/ai/article-layout /api/ai/style-capture /api/ai/style-vision /api/ai/cover-prompt /api/ai/cover-image
		file /.formatter-dynamic
	}
	handle @dynamicAI {
		request_body {
			max_size 6MB
		}
		reverse_proxy 127.0.0.1:18877 {
			header_up -RSC
			header_up -Next-Action
			header_up -Next-Resume
			header_up -X-Middleware-Subrequest
			header_up -X-Middleware-Set-Cookie
		}
	}

	@account {
		method GET POST
		path /api/account/status /api/account/login /api/account/register /api/account/reset /api/account/switch /api/account/logout /api/account/logout-all /api/account/entry /auth/callback/wechat-article-formatter
		file /.formatter-dynamic
	}
	handle @account {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:18877 {
			header_up -RSC
			header_up -Next-Action
			header_up -Next-Resume
			header_up -X-Middleware-Subrequest
			header_up -X-Middleware-Set-Cookie
		}
	}

	@legacyAI path /api/ai/analyze /api/ai/generate
	handle @legacyAI {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"ok":false,"error":{"code":"AI_NOT_CONFIGURED","message":"此入口尚未启用服务端 AI。","retryable":false}}` 503
	}

	@public path / /_next/static/*
	handle @public {
		file_server
	}
	handle {
		respond 404
	}
}
